{
  "name": "krawk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "KRAWK — a real-world-terrain goblin-slaying FPS. Type a zip code, fight on the actual ground.",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc --noEmit"
  }
}
